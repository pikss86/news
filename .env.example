# Obtain these values at https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELEGRAM_PHONE_NUMBER=+10000000000

# Keep this stable. Changing it makes an existing TDLib database unreadable.
TELEGRAM_DATABASE_ENCRYPTION_KEY=replace_with_a_long_random_secret
TDLIB_DATA_DIR=/var/lib/tdlib
TDLIB_LOG_VERBOSITY=2
TELEGRAM_DOWNLOAD_MEDIA=false
# 1-32; higher values are downloaded earlier.
TELEGRAM_MEDIA_DOWNLOAD_PRIORITY=16

POSTGRES_DB=news
POSTGRES_USER=news
POSTGRES_PASSWORD=replace_with_a_long_random_secret
DATABASE_URL=postgresql+asyncpg://news:replace_with_a_long_random_secret@postgres:5432/news

LOG_LEVEL=INFO
