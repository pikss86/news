# The normal first-run flow needs no .env file. These are optional deployment overrides.
ADMIN_PORT=8080
ADMIN_COOKIE_SECURE=false
LOG_LEVEL=INFO

# Leave all three empty for conservative automatic Amnezia interface discovery.
AMNEZIA_ADMIN_INTERFACE=
AMNEZIA_ADMIN_BIND_ADDRESS=
AMNEZIA_ADMIN_ALLOWED_CIDRS=

# Optional TDLib source pin used only while building the image.
TDLIB_GIT_REF=022d60202e446ad1287b9fb68e687c8a0760788b

# Emergency environment-only recovery (`docker compose --profile recovery run --rm collector-recovery`).
# This mode does not merge these values into encrypted UI settings.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=
TELEGRAM_DATABASE_ENCRYPTION_KEY=
TDLIB_DATA_DIR=/var/lib/tdlib
TDLIB_LIBRARY_PATH=/usr/local/lib/libtdjson.so
DATABASE_URL=
TELEGRAM_DOWNLOAD_MEDIA=false
TELEGRAM_MEDIA_DOWNLOAD_PRIORITY=16
DATABASE_RETRY_INITIAL_SECONDS=1
DATABASE_RETRY_MAX_SECONDS=30
